# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: URL de conexão principal. 
# No Vercel, use a URL do Turso (libsql://...) para que o Prisma funcione em serverless.
DATABASE_URL=

# Turso Database (Configurações adicionais se usar o adapter em src/lib/prisma.ts)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Cloudinary (Image Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
