2:["$","html",null,{"lang":"pt-BR","children":["$","body",null,{"className":"__variable_f367f3 __variable_eea437 antialiased","children":[["$","$L13",null,{}],["$","$L14",null,{"content":{"show_blog":"false","footer_cta_title":"Interessado em apoiar uma expedição?","footer_cta_desc":"Estou sempre em busca de parceiros para patrocinar novas jornadas.","footer_copyright":"Diogo Alves Fotografia. Todos os direitos reservados.","footer_tagline":"SÃO PAULO | SANTA CATARINA","social_instagram":"https://www.instagram.com/diogoalves.fotografo/","social_twitter":"","social_facebook":"","social_behance":"","social_flickr":"","social_500px":"","social_linkedin":"","social_pinterest":"","social_vero":"","social_unsplash":"https://unsplash.com/pt-br/@outtimer","home_hero_title_1":"Diogo Alves","home_hero_title_2":"Fotografia","home_hero_subtitle":"Fotógrafo de Paisagens & Vida","home_hero_bg_url":"https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&q=80&w=2000","home_hero_main_text":"Capturando a essência do cotidiano em luz e cor.","home_gallery_title":"Trabalhos Selecionados","home_blog_title":"Crônicas & Jornadas","about_greeting":"Olá, eu sou o Diogo","about_title_normal":"Um curioso por natureza,","about_title_styled":"apaixonado por café","about_bio":"Paulistano de alma, encontro paz em caminhadas matinais e na luz que banha as ruas antes da cidade acordar. Sempre com um livro ou uma câmera por perto, busco a beleza no ordinário e nas histórias que as pessoas esquecem de contar.","about_years":"5+","about_equipment":"Canon 6D Mark II & 50mm 1.8","about_address":"São Paulo, Brasil - Disponível para projetos globais","about_link_text":"Minha história completa","about_photo_url":"","about_home_greeting":"Olá, eu sou o Diogo","about_home_title_normal":"Um curioso por natureza,","about_home_title_styled":"apaixonado por café","about_home_bio":"Paulistano de alma, encontro paz em caminhadas matinais e na luz que banha as ruas antes da cidade acordar. Sempre com um livro ou uma câmera por perto, busco a beleza no ordinário e nas histórias que as pessoas esquecem de contar.","about_home_photo_url":"https://res.cloudinary.com/dz91cwkn1/image/upload/v1782668737/portfolio/file_b1pxmc.jpg","about_home_link_text":"Minha história completa","about_page_title":"Sobre apaixonado por café","about_page_subtitle":"Um curioso por natureza,","about_page_bio":"Minha jornada na fotografia começou nas ruas de São Paulo, capturando a geometria brutalista e a humanidade vibrante da metrópole. Com o tempo, meu olhar se voltou para o silêncio.\r\n\r\nAcredito que uma boa fotografia não apenas documenta um momento, mas traduz o sentimento que ele evoca. Meu trabalho é minimalista por escolha, focado na pureza da colagem e na honestidade da luz.","about_page_photo_url":"https://res.cloudinary.com/dz91cwkn1/image/upload/v1782670607/portfolio/file_vjcgsi.jpg","about_page_years":"5+","about_page_equipment":"Canon 6D Mark II & 50mm 1.8","about_page_address":"São Paulo, Brasil - Disponível para projetos globais","about_page_awards":"\r\n","contact_title_normal":"Vamos","contact_title_styled":"conversar","contact_subtitle":"Aberto a patrocínios para expedições e projetos autorais","contact_info_title":"Informações Diretas","contact_info_desc":"Se você tem interesse em patrocinar uma expedição, adquirir obras originais ou propor um projeto fotográfico, sinta-se à vontade para entrar em contato.","contact_email":"diogo.out@outlook.com"}}],["$","main",null,{"children":["$","$L15",null,{"children":["$","$L3",null,{"parallelRouterKey":"children","error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L4",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$L16","forbidden":"$undefined","unauthorized":"$undefined"}]}]}]]}]}]
