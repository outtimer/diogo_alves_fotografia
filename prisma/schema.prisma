generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Photo {
  id          String   @id @default(cuid())
  url         String
  title       String
  location    String?
  category    String   // Landscape, Wildlife, Lifestyle, Daily
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  password String // Em um app real, use salt+hash
}

model Post {
  id        String   @id @default(cuid())
  title     String
  excerpt   String
  content   String
  image     String?
  date      DateTime @default(now())
  published Boolean  @default(true)
  views     Int      @default(0)
}

model SiteContent {
  key   String @id
  value String
}

model Analytics {
  id        String   @id @default(cuid())
  date      DateTime @unique @default(now())
  visits    Int      @default(0)
}
